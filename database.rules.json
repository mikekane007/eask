{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "host": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "city": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length < 20"
        },
        "scene": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'x', 'z', 'rot', 'look', 't'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "x": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "rot": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "look": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
